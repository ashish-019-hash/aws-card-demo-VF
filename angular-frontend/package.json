{
  "name": "carddemo-angular-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 0.0.0.0",
    "build": "ng build",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "e2e": "playwright test --project=chromium",
    "e2e:all": "playwright test",
    "e2e:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit",
    "e2e:install": "playwright install --with-deps chromium firefox webkit",
    "e2e:db:create": "node e2e/db-lifecycle.mjs create",
    "e2e:db:drop": "node e2e/db-lifecycle.mjs drop",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "ci": "npm run build && npm run test:ci && npm run typecheck:e2e"
  },
  "dependencies": {
    "@angular/animations": "^20.2.0",
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@angular/router": "^20.2.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.2.0",
    "@angular/cli": "^20.2.0",
    "@angular/compiler-cli": "^20.2.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "pg": "^8.23.0",
    "typescript": "~5.8.3"
  }
}
