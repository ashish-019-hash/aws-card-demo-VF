{
  "name": "carddemo-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest",
    "preview": "vite preview --host 0.0.0.0",
    "format:check": "prettier --check src",
    "format:e2e:check": "prettier --check playwright.config.ts tsconfig.e2e.json e2e",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json",
    "e2e:check": "npm run typecheck:e2e && npm run format:e2e:check",
    "e2e": "npm run e2e:check && playwright test",
    "e2e:local": "bash ./e2e/run-local.sh",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report",
    "e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.28.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "msw": "^2.6.6",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
