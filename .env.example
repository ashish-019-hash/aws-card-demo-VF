NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://carddemo:carddemo@localhost:5432/carddemo
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:3000
CURSOR_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_SECRET=replace-with-a-different-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=900
REPORT_TIMESTAMP_MODE=processed-or-original
LOG_LEVEL=log

REPORT_WORKER_POLL_MS=1000
REPORT_LEASE_SECONDS=30
REPORT_MAX_ATTEMPTS=3
REPORT_RETRY_DELAY_SECONDS=5
