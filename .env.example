# Copy to .env and replace every placeholder. Do not commit real values.
# APP_NODE_ENV is used by Compose; NODE_ENV is used by host-side npm commands.
APP_NODE_ENV=development
NODE_ENV=development
PORT=3000
POSTGRES_PASSWORD=replace-with-a-random-local-postgres-password
DATABASE_URL=postgresql://carddemo:replace-with-the-same-random-local-postgres-password@localhost:5432/carddemo
DATABASE_SSL=false
CORS_ORIGINS=http://localhost:3000
CURSOR_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_SECRET=replace-with-a-different-random-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=900
# Required only for the development seed. It refuses production and requires this explicit opt-in.
SEED_ALLOW_UNSAFE=true
SEED_ADMIN_PASSWORD=replace-with-a-non-whitespace-1-to-8-character-development-password
REPORT_TIMESTAMP_MODE=processed-or-original
LOG_LEVEL=log

REPORT_WORKER_POLL_MS=1000
REPORT_LEASE_SECONDS=30
REPORT_MAX_ATTEMPTS=3
REPORT_RETRY_DELAY_SECONDS=5
