# Export these values or load this file with your deployment tool; the app does not load .env itself.
PORT=3000
DATABASE_URL=postgresql://carddemo:carddemo_local_only@localhost:5432/carddemo
# Tests require this separate database name; npm test refuses DATABASE_URL.
TEST_DATABASE_URL=postgresql://carddemo:carddemo_local_only@localhost:5432/carddemo_test
DB_POOL_MAX=10
# Enable only when your database requires TLS. Certificate verification stays enabled by default.
DB_SSL=false
# Optional PEM CA bundle; use literal \n escapes in environment configuration.
DB_SSL_CA=
# Development-only explicit TLS verification opt-out. Never set false in production.
DB_SSL_REJECT_UNAUTHORIZED=true
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
NODE_ENV=development
TRUST_PROXY=1
