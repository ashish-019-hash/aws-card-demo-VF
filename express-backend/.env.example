# Export these values or load this file with your deployment tool; the app does not load .env itself.
PORT=3000
# Required when NODE_ENV=production; use a long random value.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
# Generated automatically by npm start when absent. This directory is gitignored.
DATA_FILE=./data/carddemo.json
NODE_ENV=development
# In production behind TLS termination, set to true, a hop count (for example 1), or trusted proxy CIDRs.
TRUST_PROXY=1
